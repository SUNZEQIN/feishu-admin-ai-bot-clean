SERVER_PORT=8082
# INFO：只看阶段和摘要；DEBUG：额外打印大模型原文、CLI 原始输出、飞书完整响应。
APP_LOG_LEVEL=INFO
MYSQL_URL=jdbc:mysql://mysql:3306/feishu_admin_bot?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=feishu_bot
MYSQL_PASSWORD=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# lark-cli 会读取同一个飞书应用配置；docker-compose 会把 .env 挂到容器 /app/.env。
# 如果你的 lark-cli 版本要求单独变量，可以保持和 FEISHU_APP_ID / FEISHU_APP_SECRET 一致。
LARKSUITE_CLI_APP_ID=
LARKSUITE_CLI_APP_SECRET=
LARKSUITE_CLI_DEFAULT_AS=bot
FEISHU_PROCESSING_REPLY_ENABLED=true
FEISHU_PROCESSING_REPLY_TEXT=⏳ 正在处理，请稍等...
# 飞书 reaction 的 emoji_type 大小写敏感；常用值：Get,OnIt,OK,SMILE,THUMBSUP,DONE。
FEISHU_PROCESSING_REACTION_TYPES=Get,OnIt
FEISHU_OAUTH_REDIRECT_URI=http://你的服务器IP:8082/api/feishu/oauth/callback
FEISHU_OAUTH_AUTHORIZE_BASE_URL=https://accounts.feishu.cn
FEISHU_OAUTH_DEFAULT_SCOPES=offline_access
FEISHU_OAUTH_REFRESH_BEFORE_SECONDS=600
FEISHU_LLM_ENABLED=false
FEISHU_LLM_BASE_URL=https://api.deepseek.com
FEISHU_LLM_API_KEY=
FEISHU_LLM_MODEL_NAME=deepseek-chat
FEISHU_LLM_TEMPERATURE=0.0
FEISHU_MEMORY_ENABLED=true
FEISHU_MEMORY_MAX_MESSAGES=20
FEISHU_CLI_ENABLED=true
FEISHU_CLI_COMMAND=lark-cli
FEISHU_CLI_MAX_STEPS=15
FEISHU_CLI_TIMEOUT_SECONDS=60
FEISHU_CLI_ALLOWED_DOMAINS=im,base,docs,calendar,vc,minutes,note,contact,approval,attendance,drive,wiki,markdown,mindnotes,whiteboard
FEISHU_ECOMMERCE_MCP_ENABLED=false
FEISHU_ECOMMERCE_MCP_BASE_URL=http://127.0.0.1:8090
